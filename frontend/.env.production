# StockAI-Pro Frontend Production Environment Configuration
# These values are used when building for production (npm run build)

# API Configuration
# Base URL for the backend API (without /api/v1 suffix)
# Points to the custom domain mapped to Render backend
VITE_API_BASE_URL=https://api.stockai-pro.in

# WebSocket Configuration
# IMPORTANT: Must be an absolute URL pointing to the backend!
# This connects to the /live WebSocket endpoint on the backend
VITE_WS_URL=wss://api.stockai-pro.in/live
