# StockAI-Pro Frontend Environment Configuration Example
# Copy this file to .env.local and customize for your environment

# API Configuration
# Base URL for the backend API (without /api/v1 suffix)
# Development: http://localhost:8000
# Production: https://api.stockai-pro.in
VITE_API_BASE_URL=http://localhost:8000

# WebSocket Configuration
# IMPORTANT: Must be an absolute URL, not relative!
# Relative URLs like /ws or /live will NOT work - they connect to frontend domain
# Development: ws://localhost:8000/live
# Production: wss://api.stockai-pro.in/live
VITE_WS_URL=ws://localhost:8000/live

# Vite proxy target (optional, used for development proxy)
VITE_PROXY_TARGET=https://api.stockai-pro.in
