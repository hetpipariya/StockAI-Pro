# StockAI-Pro Frontend Local Development Environment
# This file overrides .env for local development
# It is NOT committed to git (should be in .gitignore)

# API Configuration
# For local development, you can either:
# 1. Point to local backend: http://localhost:8000
# 2. Point to production backend: https://api.stockai-pro.in

# Option 1: Local backend (default for development)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/live

# Option 2: Production backend (uncomment to use)
# VITE_API_BASE_URL=https://api.stockai-pro.in
# VITE_WS_URL=wss://api.stockai-pro.in/live

# Vite proxy target (used by vite.config.js for proxying in dev mode)
VITE_PROXY_TARGET=http://localhost:8000
