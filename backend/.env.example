# ═══════════════════════════════════════════════════════════════
# StockAI-Pro Backend — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git!

# ── App Environment ──────────────────────────────────────────
# Set to "production" on deployment servers (enforces strict secret checks)
APP_ENV=production
# Backward-compatible alias (app also reads ENV if APP_ENV is missing)
ENV=production

# ── Database ─────────────────────────────────────────────────
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stockai
# SQLite (development fallback — auto-detected if DATABASE_URL is empty):
# DATABASE_URL=
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/stockai
REQUIRE_POSTGRES=true
DB_SLOW_QUERY_MS=100
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_COMMAND_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000
DB_MAX_RETRIES=3
DB_RETRY_BASE_DELAY_SECONDS=0.2
RESET_SQLITE_ON_START=true

# ── JWT Authentication ────────────────────────────────────────
# REQUIRED in production! Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=REPLACE_WITH_GENERATED_64_CHAR_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Angel One SmartAPI ───────────────────────────────────────
SMARTAPI_API_KEY=your_smartapi_key
SMARTAPI_CLIENT_ID=your_client_id
SMARTAPI_CLIENT_PWD=your_trading_password
SMARTAPI_TOTP_SECRET=your_totp_secret
SMARTAPI_EXCHANGE=NSE

# ── Server ───────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
API_RATE_LIMIT=200

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=https://stockai-pro.in,https://www.stockai-pro.in,https://stockai-pro.pages.dev

# ── News API ─────────────────────────────────────────────────
NEWS_API_KEY=your_gnews_api_key

# ── Trading Safety ───────────────────────────────────────────
TRADING_MODE=PAPER
TRADING_ENABLED=true
LIVE_CONFIRMED=false
ENABLE_MOCK_DATA=false

# ── Cache TTLs (seconds) ─────────────────────────────────────
CACHE_TTL_SNAPSHOT_SECONDS=5
CACHE_TTL_CANDLES_SECONDS=10
CACHE_TTL_PREDICTION_SECONDS=5
CACHE_TTL_BUNDLE_SECONDS=5
BUNDLE_PREWARM_CONCURRENCY=3
WS_AUTH_DB_TIMEOUT_SECONDS=2.0
SCHEDULER_JOB_TIMEOUT_SECONDS=120
SCHEDULER_JOB_MAX_INSTANCES=1
FAST_STARTUP_MODE=true
FAST_STARTUP_DB_INIT_TIMEOUT_SECONDS=6.0
INSTRUMENT_MASTER_URL=https://margincalculator.angelbroking.com/OpenAPI_File/files/OpenAPIScripMaster.json
INSTRUMENT_FETCH_TIMEOUT_SECONDS=30
INSTRUMENT_FETCH_RETRIES=3
INSTRUMENT_REDIS_TTL_SECONDS=86400
INSTRUMENT_REFRESH_HOUR=8
INSTRUMENT_REFRESH_MINUTE=0

# ── Capital & Risk ───────────────────────────────────────────
STARTING_CAPITAL=100000
MIN_ACCOUNT_BALANCE=10000
MAX_RISK_PER_TRADE_PCT=0.01
MAX_TRADES_PER_DAY=10
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_LIMIT_PCT=0.03

# ── Market Hours (IST) ──────────────────────────────────────
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
