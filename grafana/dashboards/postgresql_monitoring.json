          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "stockai_db_pool_overflow",
          "legendFormat": "Overflow",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Database Connection Pool Utilisation",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
