# ====================================================================
# StockAI Pro root environment template
# ====================================================================
# Copy to .env for local docker/dev runs. Do not commit real secrets.

# ---- Runtime mode ----------------------------------------------------
APP_ENV=development
ENV=development

# ---- Core backend runtime --------------------------------------------
DATABASE_URL=postgresql+asyncpg://stockai:stockai_password@postgres:5432/stockai_db
REDIS_URL=redis://redis:6379/0
JWT_SECRET=REPLACE_WITH_A_STRONG_64_CHAR_SECRET

# ---- SmartAPI credentials --------------------------------------------
SMARTAPI_API_KEY=replace_me
SMARTAPI_CLIENT_ID=replace_me
SMARTAPI_CLIENT_PWD=replace_me
SMARTAPI_TOTP_SECRET=replace_me
SMARTAPI_EXCHANGE=NSE

# ---- API + CORS ------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=https://stockai-pro.in,https://www.stockai-pro.in,https://stockai-pro.pages.dev,http://localhost:5173

# ---- Trading safeguards ----------------------------------------------
TRADING_MODE=PAPER
TRADING_ENABLED=true
LIVE_CONFIRMED=false
ENABLE_MOCK_DATA=false
MAX_RISK_PER_TRADE_PCT=0.01
MAX_TRADES_PER_DAY=10
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_LIMIT_PCT=0.03

# ---- Optional external APIs ------------------------------------------
NEWS_API_KEY=replace_me

# ---- Frontend build-time values --------------------------------------
# Used by CI and production frontend builds.
VITE_API_BASE_URL=https://api.stockai-pro.in
VITE_WS_URL=wss://api.stockai-pro.in/live

