# ====================================================================
# STOCKAI PRO - Docker Production Environment Configuration
# Copy to .env and fill in your values for production deployment
# DO NOT COMMIT THIS FILE WITH REAL SECRETS
# ====================================================================

# ========== APPLICATION ENVIRONMENT ==========
APP_ENV=production
ENV=production
NODE_ENV=production
DEBUG=false

# ========== DATABASE CONFIGURATION (PostgreSQL) ==========
# For Docker Compose networking: db:5432 (service name)
# For local development: localhost:5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=stockai
DB_PORT=5432
POSTGRES_INITDB_ARGS=-c max_connections=100

# Full connection URL for backend (auto-constructed if using above)
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@db:5432/stockai

# ========== CACHE CONFIGURATION (Redis) ==========
# For Docker Compose networking: redis:6379 (service name)
# For local development: localhost:6379
REDIS_URL=redis://redis:6379/0

# ========== BACKEND API CONFIGURATION ==========
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-64-chars

# ========== SMARTAPI BROKER CREDENTIALS ==========
# Angel Broking API - Required for live trading
SMARTAPI_API_KEY=your_api_key_here
SMARTAPI_CLIENT_ID=your_client_id
SMARTAPI_PASSWORD=your_client_password
SMARTAPI_TOTP_SECRET=your_2fa_secret
SMARTAPI_EXCHANGE=NSE

# ========== UPSTOX BROKER CREDENTIALS ==========
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=https://your-redirect-uri.example/callback
UPSTOX_ACCESS_TOKEN=your_upstox_access_token
UPSTOX_REFRESH_TOKEN=
UPSTOX_AUTH_CODE=
UPSTOX_WS_URL=wss://api.upstox.com/v2/feed/market-data-feed

# ========== BROKER ROUTING ==========
BROKER_PRIMARY=smartapi
BROKER_FALLBACK=upstox

# ========== CORS AND NETWORKING ==========
# Comma-separated list of allowed origins
CORS_ORIGINS=https://stockai-pro.in,https://www.stockai-pro.in,http://localhost:5173

# Backend API endpoint (for frontend)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/live

# ========== OPTIONAL API KEYS ==========
NEWS_API_KEY=optional_news_api_key_for_sentiment_analysis
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY

# ========== TRADING CONFIGURATION ==========
TRADING_MODE=PAPER
TRADING_ENABLED=true
LIVE_CONFIRMED=false
ENABLE_MOCK_DATA=false

# Risk management
MAX_RISK_PER_TRADE_PCT=0.01
MAX_TRADES_PER_DAY=10
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_LIMIT_PCT=0.03

# ========== NGINX CONFIGURATION ==========
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ========== MONITORING (Prometheus & Grafana) ==========
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_in_production

# ========== SSL/TLS (Optional for Production) ==========
# For HTTPS support with Let's Encrypt:
# 1. Generate: certbot certonly --standalone -d yourdomain.com
# 2. Uncomment and set certificate paths below
# 3. Update nginx.conf to enable SSL
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# ========== LOGGING ==========
LOG_LEVEL=INFO

# ========== PERFORMANCE TUNING ==========
# Backend workers (for gunicorn, leave empty for auto)
WORKERS=4

# Database settings
DB_MAX_CONNECTIONS=100
DB_POOL_TIMEOUT=30

# Redis settings
REDIS_MAXMEMORY=512mb
REDIS_EVICTION_POLICY=allkeys-lru

# ========== SESSION & TOKENS ==========
SESSION_TIMEOUT=30
TOKEN_EXPIRATION=24

# ========== FEATURE FLAGS ==========
ENABLE_TRADING=true
ENABLE_LIVE_DATA=true
ENABLE_HISTORICAL_DATA=true
ENABLE_PREDICTIONS=true
