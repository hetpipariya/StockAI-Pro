# Copy to infra/.env.prod on the VPS host and fill all values.

POSTGRES_USER=stockai
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=stockai

JWT_SECRET=replace_with_a_strong_64_plus_char_secret

SMARTAPI_API_KEY=
SMARTAPI_CLIENT_ID=
SMARTAPI_CLIENT_PWD=
SMARTAPI_TOTP_SECRET=
NEWS_API_KEY=

CORS_ORIGINS=https://stockai-pro.in,https://www.stockai-pro.in

LOG_LEVEL=INFO
LOG_FORMAT=json
UVICORN_WORKERS=2
UVICORN_ACCESS_LOG=false
FORWARDED_ALLOW_IPS=*

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace_with_grafana_admin_password

# Set these before running docker compose.
BACKEND_IMAGE=dockerhub_user/stockai-pro-backend:sha-<commit>
FRONTEND_IMAGE=dockerhub_user/stockai-pro-frontend:sha-<commit>
